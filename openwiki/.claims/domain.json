        {
          "resource": "repo://src/components/dataTypes/TraceLinkTypes.tsx#L16-L83",
          "version": "repo-lines-v1:sha256:4fbccbbc49d79155db26dacb05ee3488aac13e662dd49634a0a52ed1c8c32826:"
        }
      ]
    },
