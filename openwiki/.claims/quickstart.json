    {
      "id": "claim_782f48cf52734230887fb77708ec8ced",
      "statement": "src/proxy.ts is the app-wide middleware for every /api/* request (config.matcher '/api/:path*'): it reads the X-Target-API request header, rejects a missing header with 400, an unparseable URL with 400, and a non-HTTP/S protocol with 403, then rewrites the request with NextResponse.rewrite to {target origin}/api/<same path>; the repository defines no local API route handlers, so all /api traffic is proxied to the configured ARDoCo backend.",
      "evidence": [
        {
          "resource": "repo://src/proxy.ts#L4-L35",
          "version": "repo-lines-v1:sha256:5e376f4ed249f0e11df4dddb2f437dbc3f8a24a47bd48ba4fe65fface27ebb82:"
        }
      ]
    },
