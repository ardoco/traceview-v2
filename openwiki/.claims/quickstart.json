  "claims": [
    {
      "id": "claim_8e09ffa7347d45e1a3a6b5bcf8b3fef1",
      "statement": "TraceView is a browser-based, installation-free Next.js/React (TypeScript) frontend for ARDoCo's traceability link recovery pipelines: users combine software architecture documentation (SAD), an architecture model (SAM), and a code model, submit them to a remote ARDoCo REST backend, and explore recovered trace links plus TEAM/MEAT inconsistencies in an interactive multi-panel viewer.",
      "evidence": [
        {
          "resource": "repo://README.md#L1-L21",
          "version": "repo-lines-v1:sha256:f9c5532ab12b86f3812e3c9d0aac3c721068ab13b50daf776a82c6f0fb410645:"
        },
        {
          "resource": "repo://src/app/page.tsx#L29-L45",
          "version": "repo-lines-v1:sha256:879c8fc65e09da8626557ff307f13c59ec165667f7f680cb68b9f0aff56aa75c:"
        }
      ]
    },
    {
      "id": "claim_73c7f624530a4bd2b36102ede7483ae2",
      "statement": "The four supported trace-link pipelines are defined in the TraceLinkTypes record — SAD_SAM_CODE (TransArC), SAD_SAM (SWATTR), SAD_CODE (ArDoCode), SAM_CODE (ArCoTL) — and each entry's checkCondition predicate gates whether the pipeline is selectable based on the uploaded file types, with PCM and UML both counting as the single architecture-model input.",
      "evidence": [
        {
          "resource": "repo://src/components/dataTypes/TraceLinkTypes.tsx#L16-L77",
          "version": "repo-lines-v1:sha256:5bad882271f4c3b209cb2904aa813a334e5cde1f179ea844a0f705d555c18281:"
        }
      ]
    },
