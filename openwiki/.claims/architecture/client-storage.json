    {
      "id": "claim_7ea5e45ef5c44d919d30dd33f0d42d77",
      "statement": "ClientFileStorage persists all project artifacts in the browser's Origin Private File System: each function resolves navigator.storage.getDirectory() and one sub-directory per project via getDirectoryHandle(projectId, {create: true}); the new-project wizard keys that directory by the backend requestId while the load-project flow keys it by a locally generated uuidv4.",
