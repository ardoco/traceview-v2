    {
      "id": "claim_95726c8436264187b317e682a36cf4ab",
      "statement": "getStoredFileName stores both PCM and UML architecture models under the shared name 'Architecture Model' while every other artifact uses its FileType value; project.meta.json therefore records fileType, storedFileName, and originalName per file and is the only record of the actual architecture-model format and original names, and the form validators' limit of one architecture model (PCM or UML combined) is what prevents two models from colliding on the shared name.",
      "evidence": [
        {
          "resource": "repo://src/components/multiStepForm/FormValidation.tsx#L24-L28",
          "version": "repo-lines-v1:sha256:7c89336f49533e1c6340c539106324a18b4a8f9566307027bfcfc84bc2693495:"
