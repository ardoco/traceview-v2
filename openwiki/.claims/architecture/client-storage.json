    {
      "id": "claim_117a314938bf489abb4484acf7051308",
      "statement": "loadProjectFile resolves the actual stored file from metadata rather than trusting the caller's type: it computes the candidate name from the fallbackType, reads project.meta.json and matches by storedFileName to re-derive the actual type and name, falls back to the fallbackType when metadata is missing or unreadable (warned, not fatal), and finally reads the file text returning {content, fileType} or null on NotFoundError while rethrowing all other errors; convertStringToFileType defaults the shared name 'Architecture Model' to UML when metadata is absent, which the ArchitectureModelViewer relies on to choose between parsePCM and parseUMLModel.",
      "evidence": [
        {
          "resource": "repo://src/components/dataTypes/FileType.tsx#L11-L19",
          "version": "repo-lines-v1:sha256:23690cc474ddcf0185fe97af3a7d7892d600ff9b5b69ccfdf0bdd84c9fe9e8e7:"
        },
        {
