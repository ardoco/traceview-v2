    {
      "id": "claim_bc99402930e241cab7389d8e5b6ebde5",
      "statement": "Uploaded project artifacts and metadata are persisted only in the browser's Origin Private File System via navigator.storage.getDirectory(), in per-project directories keyed by the request id; no TraceView-owned server storage exists. Clearing browser site data removes every stored project, and confirming the navigation guard (ConfirmNavigationModal through NavigationContext) immediately deletes the current project's OPFS directory via deleteProjectDirectory.",
      "evidence": [
