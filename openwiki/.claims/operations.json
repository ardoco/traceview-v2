        }
      ]
    },
    {
      "id": "claim_f7fdcb0ce05f4354bcbc49b291f66d07",
      "statement": "All backend calls are proxied through the Next.js proxy middleware in src/proxy.ts, which is matched on every /api/:path* request: client fetches attach the selected backend base URL in an X-Target-API header (ArdocoApi.startRun and the ApiAddressContext health probe both do this), and the middleware rewrites the request to {target}/api/{path}; it fails fast with 400 when the header is missing, 400 when the header is not a valid URL, and 403 when the target protocol is not HTTP/S — so backend connectivity problems surface as these middleware errors or failed /api/health probes, not as build-time configuration.",
      "evidence": [
        {
          "resource": "repo://src/contexts/ApiAddressContext.tsx#L38-L48",
          "version": "repo-lines-v1:sha256:8c2742af45c1a97f5b989ecfb860661c4cf73150da81dff6e3be71fe806db2a1:"
