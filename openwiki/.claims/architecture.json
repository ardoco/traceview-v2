    {
      "id": "claim_f1426073d99842f6aa979a30ddb768ab",
      "statement": "The /view/[id] page polls /api/get-result/{id} every 5 seconds for up to 240 seconds using the NavigationContext AbortController signal: status OK returns the payload, ACCEPTED keeps polling, any other status raises an error carrying the backend message, and the timeout raises a still-processing error; AbortErrors are swallowed so navigation away ends polling silently, and failures surface in a LoadingErrorModal with Retry and View Files Only options.",
      "evidence": [
        {
          "resource": "repo://src/app/view/%5Bid%5D/page.tsx#L106-L113",
