    {
      "id": "claim_8c7dbfb226d847a18e7f4be125d5ba9b",
      "statement": "src/app/layout.tsx wraps every page in ApiAddressProvider -> NavigationProvider, renders NavBar above a fixed scrollable content area, and loads globals.css, the Inter font, and global metadata, so the backend address and navigation guard are available to all routes without per-page wiring.",
      "evidence": [
        {
          "resource": "repo://src/app/layout.tsx#L23-L44",
          "version": "repo-lines-v1:sha256:694db417bfff973a5cc959400372b376c3f891acd5b03eb375b0bd14c46cd969:"
        }
      ]
    },
    {
      "id": "claim_2fcaa01f1e94479dbf567fcf4c0277f7",
      "statement": "src/proxy.ts is the app-wide handler for /api/* requests (config matcher '/api/:path*'): it reads the X-Target-API header, rejects a missing header or unparseable URL with 400 and a non-http/https target with 403, and otherwise rewrites the request with NextResponse.rewrite to `${target.origin}/api/<path>` while preserving the original headers; the repo defines no local API route handlers.",
      "evidence": [
        {
          "resource": "repo://src/proxy.ts#L5-L35",
          "version": "repo-lines-v1:sha256:f9fcbe9891d0523e1c92fa7de4bd6d536f6e469add15ceb70eb5fedda4dc805f:"
        }
      ]
    },
