  "claims": [
    {
      "id": "claim_32d02b5a747643218024ccbbbd1ad102",
      "statement": "TraceView defines no local /api route handlers; src/proxy.ts is the app-wide Next.js proxy middleware matching '/api/:path*', and it forwards every /api/* request by rewriting it with NextResponse.rewrite to {X-Target-API origin}/api/<same path>, preserving the original request headers.",
      "evidence": [
        {
          "resource": "repo://src/proxy.ts#L4-L35",
          "version": "repo-lines-v1:sha256:5e376f4ed249f0e11df4dddb2f437dbc3f8a24a47bd48ba4fe65fface27ebb82:"
        }
      ]
    },
    {
      "id": "claim_f29e0f007be545a991497ed403c492b0",
      "statement": "The proxy middleware rejects requests before rewriting when its contract is violated: a missing X-Target-API header returns 400, a header value that is not a parseable URL returns 400, and a target whose protocol is neither http: nor https: returns 403.",
      "evidence": [
        {
          "resource": "repo://src/proxy.ts#L10-L25",
          "version": "repo-lines-v1:sha256:6fcfb913a5ae33b27b125c50bc21577655307f87e1a875598e069e2409e3fbc0:"
        }
      ]
    },
