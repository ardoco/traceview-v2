    {
      "id": "claim_48c43f9d20ef45869972ece65459913c",
      "statement": "fetchArdocoApi assembles the multipart body per pipeline: projectName is always appended, and each pipeline appends only its required inputs — TransArC (SAD_SAM_CODE): inputCode, inputText, inputArchitectureModel, inputArchitectureModelFormat; ArDoCode (SAD_CODE): inputCode and inputText; ArCoTL (SAM_CODE): inputCode, inputArchitectureModel, inputArchitectureModelFormat; SWATTR (SAD_SAM): inputText, inputArchitectureModel, inputArchitectureModelFormat — each taken from the first uploaded file matching the required FileType, with inputArchitectureModelFormat carrying the PCM/UML FileType of the chosen architecture model.",
      "evidence": [
        {
